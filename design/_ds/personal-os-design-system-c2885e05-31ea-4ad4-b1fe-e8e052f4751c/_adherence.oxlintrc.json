{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Rajdhani))/i]",
        "message": "Font not provided by the design system. Available: Inter, Rajdhani."
      },
      {
        "selector": "JSXOpeningElement[name.name='AISendButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|onClick|style|className|key|ref|className|style|children)$/]",
        "message": "<AISendButton> doesn't accept that prop. Declared props: state, onClick, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AISendButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|pressed|focus|disabled)$/]",
        "message": "<AISendButton> state must be one of 'default' | 'hover' | 'pressed' | 'focus' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|padding|children|style|className|key|ref|className|style|children)$/]",
        "message": "<BaseCard> doesn't accept that prop. Declared props: elevation, padding, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BaseCard'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:card|glow|elevated|soft)$/]",
        "message": "<BaseCard> elevation must be one of 'card' | 'glow' | 'elevated' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconContainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|style|className|key|ref|className|style|children)$/]",
        "message": "<IconContainer> doesn't accept that prop. Declared props: icon, size, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPICard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|progress|subtitle|action|onAction|style|className|key|ref|className|style|children)$/]",
        "message": "<KPICard> doesn't accept that prop. Declared props: label, value, progress, subtitle, action, onAction, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|checked|onToggle|style|className|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: label, meta, checked, onToggle, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|state|icon|onClick|style|className|key|ref|className|style|children)$/]",
        "message": "<PrimaryButton> doesn't accept that prop. Declared props: children, state, icon, onClick, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|pressed|focus|disabled)$/]",
        "message": "<PrimaryButton> state must be one of 'default' | 'hover' | 'pressed' | 'focus' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|height|style|className|key|ref|className|style|children)$/]",
        "message": "<ProgressIndicator> doesn't accept that prop. Declared props: value, height, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|shortcut|value|onChange|style|className|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, shortcut, value, onChange, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SecondaryButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|onClick|style|className|key|ref|className|style|children)$/]",
        "message": "<SecondaryButton> doesn't accept that prop. Declared props: children, icon, onClick, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|onAction|elevation|children|style|className|key|ref|className|style|children)$/]",
        "message": "<SectionCard> doesn't accept that prop. Declared props: title, action, onAction, elevation, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCard'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:card|glow|elevated|soft)$/]",
        "message": "<SectionCard> elevation must be one of 'card' | 'glow' | 'elevated' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavigationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|state|onClick|style|className|key|ref|className|style|children)$/]",
        "message": "<SidebarNavigationItem> doesn't accept that prop. Declared props: icon, label, state, onClick, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavigationItem'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:active|default)$/]",
        "message": "<SidebarNavigationItem> state must be one of 'active' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|state|onClick|style|className|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: icon, label, state, onClick, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:active|default|hover)$/]",
        "message": "<SidebarNavItem> state must be one of 'active' | 'default' | 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|className|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: children, tone, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|success|warning|danger|info|neutral)$/]",
        "message": "<StatusChip> tone must be one of 'accent' | 'success' | 'warning' | 'danger' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|size|onChange|style|className|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: on, size, onChange, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Toggle> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavigationAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|active|onClick|style|className|key|ref|className|style|children)$/]",
        "message": "<TopNavigationAction> doesn't accept that prop. Declared props: icon, active, onClick, style, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
